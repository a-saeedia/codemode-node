{
  "name": "node-code-mode",
  "version": "0.1.1",
  "description": "One MCP tool in front of all your MCP servers. Cloudflare Code Mode, running on Node.",
  "type": "module",
  "license": "MIT",
  "author": "Arman Saeedi",
  "homepage": "https://github.com/a-saeedia/node-code-mode#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/a-saeedia/node-code-mode.git"
  },
  "bugs": {
    "url": "https://github.com/a-saeedia/node-code-mode/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "code-mode",
    "codemode",
    "cloudflare",
    "ai-agents",
    "tool-calling",
    "llm",
    "sandbox"
  ],
  "bin": {
    "node-code-mode": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/executor.mjs",
    "./server": "./src/server.mjs"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE",
    "examples"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "test": "node --test test/executor.test.mjs",
    "test:integration": "node test/integration.mjs"
  },
  "dependencies": {
    "@cfworker/json-schema": "^4.1.1",
    "@cloudflare/codemode": "0.5.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cross-spawn": "^7.0.6",
    "zod": "^4.6.7"
  }
}
